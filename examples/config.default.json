{
  "log": {
    "level": "fatal",
    "disabled": false,
    "output": "/tmp/keen-singbox/sing-box.log",
    "timestamp": true
  },
  "experimental": {
    "clash_api": {
      "external_controller": "0.0.0.0:9999",
      "secret": "",
      "default_mode": "rule"
    },
    "cache_file": {
      "enabled": true,
      "path": "/tmp/keen-singbox/cache.db"
    }
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": "172.19.0.1/30",
      "mtu": 1400,
      "auto_route": false,
      "strict_route": false,
      "stack": "mixed",
      "endpoint_independent_nat": true,
      "interface_name": "opkgtun0"
    }
  ],
  "dns": {
    "servers": [
      {
        "type": "local",
        "tag": "dns-bootstrap"
      },
      {
        "type": "https",
        "tag": "dns-primary",
        "server": "1.1.1.1",
        "path": "/dns-query",
        "detour": "proxy",
        "tls": {
          "server_name": "cloudflare-dns.com"
        }
      },
      {
        "type": "https",
        "tag": "dns-fallback-1",
        "server": "1.0.0.1",
        "path": "/dns-query",
        "detour": "proxy",
        "tls": {
          "server_name": "cloudflare-dns.com"
        }
      },
      {
        "type": "https",
        "tag": "dns-fallback-2",
        "server": "8.8.8.8",
        "path": "/dns-query",
        "detour": "proxy",
        "tls": {
          "server_name": "dns.google"
        }
      },
      {
        "type": "https",
        "tag": "dns-fallback-3",
        "server": "9.9.9.9",
        "path": "/dns-query",
        "detour": "proxy",
        "tls": {
          "server_name": "dns.quad9.net"
        }
      }
    ],
    "strategy": "ipv4_only",
    "final": "dns-primary",
    "cache_capacity": 1024,
    "independent_cache": true,
    "reverse_mapping": true
  },
  "outbounds": [
    {
      "type": "urltest",
      "tag": "proxy",
      "outbounds": [
        "hysteria2",
        "tuic"
      ],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "30m",
      "tolerance": 50,
      "idle_timeout": "1h",
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "proxy-select",
      "outbounds": [
        "proxy",
        "hysteria2",
        "tuic",
        "direct"
      ],
      "default": "proxy",
      "interrupt_exist_connections": true
    },
    {
      "type": "hysteria2",
      "tag": "hysteria2",
      "server": "your-hysteria2.example.com",
      "server_port": 443,
      "domain_resolver": "dns-bootstrap",
      "password": "CHANGE_ME_HYSTERIA2_PASSWORD",
      "up_mbps": 100,
      "down_mbps": 100,
      "tls": {
        "enabled": true,
        "server_name": "your-hysteria2.example.com"
      }
    },
    {
      "type": "tuic",
      "tag": "tuic",
      "server": "your-tuic.example.com",
      "server_port": 443,
      "domain_resolver": "dns-bootstrap",
      "uuid": "00000000-0000-4000-8000-000000000001",
      "password": "CHANGE_ME_TUIC_PASSWORD",
      "congestion_control": "bbr",
      "zero_rtt_handshake": false,
      "tls": {
        "enabled": true,
        "server_name": "your-tuic.example.com",
        "alpn": [
          "h3"
        ]
      }
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": {
      "server": "dns-bootstrap",
      "strategy": "ipv4_only"
    },
