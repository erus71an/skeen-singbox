{
  "log": {
    "level": "fatal",
    "disabled": false,
    "output": "/tmp/keen-singbox/sing-box.log",
    "timestamp": true
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "/tmp/keen-singbox/cache.db"
    }
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": "172.19.0.1/30",
      "mtu": 1400,
      "auto_route": false,
      "strict_route": false,
      "stack": "mixed",
      "endpoint_independent_nat": true,
      "interface_name": "opkgtun0"
    }
  ],
  "dns": {
    "servers": [
      {
        "type": "local",
        "tag": "dns-local"
      },
      {
        "type": "https",
        "tag": "dns-primary",
        "server": "1.1.1.1",
        "path": "/dns-query",
        "detour": "proxy",
        "tls": {
          "server_name": "cloudflare-dns.com"
        }
      }
    ],
    "rules": [
      {
        "domain_keyword": [
          "keenetic",
          "netcraze"
        ],
        "server": "dns-local"
      },
      {
        "domain_suffix": [
          ".lan",
          ".local"
        ],
        "server": "dns-local"
      }
    ],
    "strategy": "ipv4_only",
    "final": "dns-primary",
    "cache_capacity": 512,
    "independent_cache": true,
    "reverse_mapping": true
  },
  "outbounds": [
    {
      "type": "selector",
      "tag": "proxy",
      "outbounds": [
        "direct"
      ],
      "default": "direct",
      "interrupt_exist_connections": true
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": {
      "server": "dns-local",
      "strategy": "ipv4_only"
    },
    "rules": [
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "port": 53,
        "action": "hijack-dns"
      },
      {
        "ip_version": 6,
        "action": "reject"
      },
      {
        "network": "tcp",
        "port": 853,
        "action": "reject"
      }
    ],
    "final": "proxy"
  }
}
