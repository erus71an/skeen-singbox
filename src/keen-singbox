script_dir() {
  CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd
}

run_cmd() {
  if [ "$DRY_RUN" = "1" ]; then
    printf '[DRY-RUN]:'
    printf ' %s' "$@"
    printf '\n'
    return 0
  fi
  "$@"
}

rotate_log_file() {
  local path="${1:-}"
  local size backup index

  [ -n "$path" ] || return 0
  [ -f "$path" ] || return 0
  case "$LOG_MAX_BYTES" in
    ""|*[!0-9]*) return 0 ;;
  esac
  size="$(wc -c <"$path" 2>/dev/null | tr -d '[:space:]')"
  [ "${size:-0}" -ge "$LOG_MAX_BYTES" ] 2>/dev/null || return 0

  index="$LOG_BACKUPS"
  while [ "$index" -gt 1 ] 2>/dev/null; do
    backup="${path}.$((index - 1))"
    [ -f "$backup" ] && mv -f "$backup" "${path}.${index}" 2>/dev/null || true
    index=$((index - 1))
  done
  [ "$LOG_BACKUPS" -gt 0 ] 2>/dev/null &&
    mv -f "$path" "${path}.1" 2>/dev/null || true
  : >"$path" 2>/dev/null || true
}

acquire_service_lock() {
  local owner lock_pid attempt=0

  mkdir -p "$(dirname "$LOCK_DIR")" 2>/dev/null ||
    die "Failed to create service lock directory: $(dirname "$LOCK_DIR")"
  while ! mkdir "$LOCK_DIR" 2>/dev/null; do
    lock_pid="$(sed -n '1p' "$LOCK_DIR/pid" 2>/dev/null || true)"
    case "$lock_pid" in
      ''|*[!0-9]*) ;;
      *)
        if kill -0 "$lock_pid" 2>/dev/null; then
          die "Another keen-singbox operation is already running (pid $lock_pid)"
        fi
        ;;
    esac
    rm -f "$LOCK_DIR/pid" 2>/dev/null || true
    rmdir "$LOCK_DIR" 2>/dev/null || true
    attempt=$((attempt + 1))
    [ "$attempt" -lt 3 ] || die "Failed to acquire service lock: $LOCK_DIR"
  done
  owner="$$"
  printf '%s\n' "$owner" >"$LOCK_DIR/pid" || {
    rmdir "$LOCK_DIR" 2>/dev/null || true
    die "Failed to write service lock: $LOCK_DIR"
  }
}

release_service_lock() {
  [ -f "$LOCK_DIR/pid" ] || return 0
  [ "$(sed -n '1p' "$LOCK_DIR/pid" 2>/dev/null || true)" = "$$" ] || return 0
  rm -f "$LOCK_DIR/pid" 2>/dev/null || true
  rmdir "$LOCK_DIR" 2>/dev/null || true
}

with_service_lock() {
  [ -f "$SETTINGS" ] && load_settings
  acquire_service_lock
  trap 'release_service_lock' EXIT
  trap 'release_service_lock; exit 143' HUP INT TERM
  "$@"
  local result=$?
  trap - EXIT HUP INT TERM
  release_service_lock
  return "$result"
}

backup_file() {
  local path="${1:-}"
  local stamp

  [ -f "$path" ] || return 0
  stamp="$(date '+%Y%m%d-%H%M%S' 2>/dev/null || date +%s)"
  cp -fp "$path" "${path}.bak.${stamp}" || die "Failed to backup $path"
  ok "Backed up $path"
}

replace_json_atomically() {
  local source="${1:-}"
  local target="${2:-}"
  local tmp_target="${target}.new.$$"

  [ -f "$source" ] || die "JSON source was not found: $source"
  cp -f "$source" "$tmp_target" || die "Failed to stage JSON: $target"
  "$JSONFILTER_BIN" -i "$tmp_target" -e '@' >/dev/null 2>&1 || {
    rm -f "$tmp_target" 2>/dev/null || true
    die "Refusing to install invalid JSON: $source"
  }
  backup_file "$target"
  mv -f "$tmp_target" "$target" || {
    rm -f "$tmp_target" 2>/dev/null || true
    die "Failed to activate JSON: $target"
  }
  chmod 644 "$target" 2>/dev/null || true
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "Required command was not found: $1"
}

json_get() {
  local file="${1:-}"
  local expr="${2:-}"

  [ -f "$file" ] || return 1
  "$JSONFILTER_BIN" -i "$file" -e "$expr" 2>/dev/null | head -n1
}

json_get_all() {
  local file="${1:-}"
  local expr="${2:-}"

  [ -f "$file" ] || return 1
  "$JSONFILTER_BIN" -i "$file" -e "$expr" 2>/dev/null
}

load_settings() {
  [ -f "$SETTINGS" ] || die "Settings not found: $SETTINGS. Run: keen-singbox install"

  PROFILE="$(json_get "$SETTINGS" '@.profile')"
  POLICY_NAME="$(json_get "$SETTINGS" '@.policy.name')"
  POLICY_TABLE4="$(json_get "$SETTINGS" '@.policy.table4')"
  TUN_NAME="$(json_get "$SETTINGS" '@.tun.name')"
  TUN_ADDRESS="$(json_get "$SETTINGS" '@.tun.address')"
  TUN_INTERFACE_NAME="$(json_get "$SETTINGS" '@.tun.interface_name')"
  TUN_DEFAULT_ROUTE="$(json_get "$SETTINGS" '@.tun.default_route')"
  TUN_TXQUEUELEN="$(json_get "$SETTINGS" '@.tun.txqueuelen')"
  TUN_WAIT_LINK_SECONDS="$(json_get "$SETTINGS" '@.tun.wait_link_seconds')"
  SINGBOX_BIN_SETTING="$(json_get "$SETTINGS" '@.singbox.bin')"
  CONFIG_SETTING="$(json_get "$SETTINGS" '@.singbox.config')"
  SINGBOX_WORK_DIR="$(json_get "$SETTINGS" '@.singbox.work_dir')"
  SINGBOX_VERSION_SETTING="$(json_get "$SETTINGS" '@.singbox.version')"
  RUNTIME_DIR_SETTING="$(json_get "$SETTINGS" '@.runtime.dir')"
  LOG_LEVEL="$(json_get "$SETTINGS" '@.runtime.log_level')"
  FIREWALL_TUN_RULES_ENABLED="$(json_get "$SETTINGS" '@.firewall.tun_rules_enabled')"
  FIREWALL_IPV6_BLOCK_MACS="$(json_get_all "$SETTINGS" '@.firewall.ipv6_block_macs[*]' || true)"
  AUTO_START_ENABLED="$(json_get "$SETTINGS" '@.auto_start.enabled')"
  AUTO_START_DELAY="$(json_get "$SETTINGS" '@.auto_start.delay')"

  : "${PROFILE:=lowmem}"
  : "${POLICY_NAME:=KeenSingBox}"
  : "${POLICY_TABLE4:=}"
  : "${TUN_NAME:=SKeen0}"
  : "${TUN_ADDRESS:=172.19.0.1/30}"
  : "${TUN_INTERFACE_NAME:=opkgtun0}"
  : "${TUN_DEFAULT_ROUTE:=1}"
  : "${TUN_TXQUEUELEN:=0}"
  : "${TUN_WAIT_LINK_SECONDS:=20}"
  : "${SINGBOX_BIN_SETTING:=$SINGBOX_BIN}"
  : "${CONFIG_SETTING:=$CONFIG}"
  : "${SINGBOX_WORK_DIR:=$WORK_DIR}"
  : "${SINGBOX_VERSION_SETTING:=}"
  : "${RUNTIME_DIR_SETTING:=$RUNTIME_DIR}"
  : "${LOG_LEVEL:=error}"
  : "${FIREWALL_TUN_RULES_ENABLED:=1}"
  : "${FIREWALL_IPV6_BLOCK_MACS:=}"
  : "${AUTO_START_ENABLED:=1}"
  : "${AUTO_START_DELAY:=30}"

  SINGBOX_BIN="$SINGBOX_BIN_SETTING"
  CONFIG="$CONFIG_SETTING"
  # An explicit runtime override is useful for recovery and keeps all transient
  # files off persistent storage during tests or emergency repairs.
  RUNTIME_DIR="${KEEN_SINGBOX_RUNTIME_DIR:-$RUNTIME_DIR_SETTING}"
  LOCK_DIR="${KEEN_SINGBOX_LOCK_DIR:-${RUNTIME_DIR}/service.lock}"
  TMP_DIR="${KEEN_SINGBOX_TMP_DIR:-${RUNTIME_DIR}/tmp}"
  LOG_FILE="${KEEN_SINGBOX_LOG:-${RUNTIME_DIR}/keen-singbox.log}"
  RUNNER_SCRIPT="${KEEN_SINGBOX_RUNNER:-${RUNTIME_DIR}/runner.sh}"
}

is_valid_ipv4() {
  local ip="${1:-}"
  local octet old_ifs

  old_ifs="$IFS"
  IFS=.
  set -- $ip
  IFS="$old_ifs"

  [ "$#" -eq 4 ] || return 1
  for octet in "$@"; do
    case "$octet" in
      ""|*[!0-9]*) return 1 ;;
    esac
    [ "$octet" -ge 0 ] 2>/dev/null && [ "$octet" -le 255 ] 2>/dev/null || return 1
  done
}

