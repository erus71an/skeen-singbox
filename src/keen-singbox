info() { printf '[INFO]: %s\n' "$1"; log "INFO" "$1"; }
ok() { printf '[OK]: %s\n' "$1"; log "OK" "$1"; }
warn() { printf '[WARN]: %s\n' "$1"; log "WARN" "$1"; }
err() { printf '[ERROR]: %s\n' "$1" >&2; log "ERROR" "$1"; }
die() { err "$1"; exit 1; }

log() {
  local level="${1:-INFO}"
  local message="${2:-}"
  local timestamp

  case "${LOG_LEVEL:-error}:$level" in
    debug:*|info:INFO|info:OK|info:WARN|info:ERROR|warn:WARN|warn:ERROR|error:ERROR) ;;
    *) return 0 ;;
  esac

  mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null || return 0
  rotate_log_file "$LOG_FILE"
  timestamp="$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || date 2>/dev/null || printf unknown)"
  printf '%s [%s] %s\n' "$timestamp" "$level" "$message" >>"$LOG_FILE" 2>/dev/null || true
}

